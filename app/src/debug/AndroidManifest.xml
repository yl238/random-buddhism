<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb arm the real daily alarm a few seconds from now, or re-roll it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugTriggerReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="org.randomdhamma.debug.FIRE_IN" />
                <action android:name="org.randomdhamma.debug.REROLL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
